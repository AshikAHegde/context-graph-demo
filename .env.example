# Neo4j AuraDB Connection
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_aura_password

# Google Gemini API Key(s) (Supports multiple fallback keys: comma-separated or numbered)
# Example 1: Single key
GOOGLE_API_KEY=your_google_api_key

# Example 2: Multiple fallback keys (comma-separated):
# GOOGLE_API_KEYS=key_1,key_2,key_3

# Example 3: Numbered fallback keys:
# GOOGLE_API_KEY_1=key_1
# GOOGLE_API_KEY_2=key_2
# GOOGLE_API_KEY_3=key_3

# Optional: Override default models
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768
